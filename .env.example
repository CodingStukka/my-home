# The settings for compose.yaml. Copy this file to .env, next to compose.yaml, and fill in
# the two secrets. Keep .env to yourself: it's the key to your data.

# ---------- Required ----------

# The app's own secret: it signs the sign-ins. Random, 64 characters — make one with
#   openssl rand -hex 32
APP_SECRET=

# The database's password. Random as well — make one the same way:
#   openssl rand -hex 32
# Only used when the database is created on the very first start: don't change it later.
POSTGRES_PASSWORD=

# ---------- Optional (remove the # to use one) ----------

# The port My Home listens on, on this machine. Default: 9090.
#MH_PORT=9090

# Your reverse proxy's address as the app sees it — comma-separated addresses or ranges.
# Only requests from there may say "this was https" (then the sign-in cookie is Secure) and
# "this came from device X" (each device gets its own sign-in limit). Open
# https://<the app's address>/api/proxy-check (through the proxy): it says what to put here.
# Never your whole home network's range. Default: 127.0.0.1 (no proxy).
#TRUSTED_PROXIES=172.16.0.0/12

# The app's https address. Opened as http://<this machine>:9090 on a phone, the install page
# then offers to open it there (installing needs https). Default: none.
#MH_SECURE_URL=https://myhome.example.org/

# The time zone. Default: Europe/Brussels.
#TZ=Europe/Brussels
